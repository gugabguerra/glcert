# .env — gitignored, loaded on startup when present.
#
# Config layering, rightmost wins:
#   defaults -> config.json -> .env -> real environment
#
# Keyed by environment-variable names (SCREAMING_SNAKE_CASE), never by config-file keys.
# A bad line or an unrecognized key warns and is skipped — it never stops the process.
# Values here are personal to this machine: paths, ports, log verbosity for local runs.
# Keep private hosts, credentials, and tokens out of tracked files.

# PORT=18080
# DATA_DIR=data
# LOG_LEVEL=debug
